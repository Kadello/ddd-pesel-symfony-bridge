{
  "name": "twoj-nick/pesel-bundle",
  "description": "Symfony Bundle providing PESEL Value Object, Domain Validation, and Form Type",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Szymon Kadelski",
      "email": "szymonkadelski@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "symfony/form": "^6.4 || ^7.0",
    "symfony/validator": "^6.4 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.50"
  },
  "autoload": {
    "psr-4": {
      "App\\PeselBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\PeselBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse src --level=max",
    "cs-check": "php-cs-fixer check --diff"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
